# ===== managed by fix-gitignore script =====
# node
node_modules/
npm-cache/
*.log

# backup & temp
*.bak
*.bak-*
*.bak.*
*.tmp
*.old
*.orig
*.rej
*~

# local scripts (may contain tokens)
*.bat
*.ps1
*.lnk
*.hta

# editor / os
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# deps / cache
__pycache__/
*.pyc
.venv/
venv/
pip-*/
uv-cache/
.uv-cache/

# secrets - never commit
.env
.env.*
*.pem
*.key
*token*.txt
